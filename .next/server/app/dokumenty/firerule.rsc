6:["$","section",null,{"id":"responsibilities","className":"mb-8 bg-white rounded-xl shadow p-6","children":[["$","h2",null,{"className":"text-xl font-bold text-cyan-800 mb-2","children":"Обязанности Председателя"}],["$","ul",null,{"className":"list-disc pl-6 space-y-1 text-gray-800","children":[["$","li",null,{"children":"Обеспечивать в рамках компетенции изучение и выполнение настоящего Положения всеми правообладателями садовых участков."}],["$","li",null,{"children":"Периодически, но не менее двух раз в летний период проверять соблюдение требований пожарной безопасности."}],["$","li",null,{"children":"Не допускать загромождения основных проездов и улиц на проезжей части дорог."}],["$","li",null,{"children":"Обеспечивать своевременное проведение профилактических осмотров и планово-предупредительный ремонт электроустановок."}]]}]]}]
